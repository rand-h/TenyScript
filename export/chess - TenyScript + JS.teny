// =====================================================================
// ♟️ TENY-CHESS GRANDMASTER : LE VRAI MOTEUR MATHÉMATIQUE
// =====================================================================

$>css_style() {
    .chess-wrapper { max-width: 550px; margin: 0 auto; }
    .board { display: grid; grid-template-columns: repeat(8, 1fr); aspect-ratio: 1/1; box-shadow: 0 10px 30px rgba(0,0,0,0.8); border-radius: 4px; overflow: hidden; border: 4px solid #161512; }
    .square { position: relative; display: flex; align-items: center; justify-content: center; cursor: pointer; font-size: clamp(30px, 8vw, 50px); min-width: 55px; min-height: 55px;}
    .light { background-color: #ebecd0; }
    .dark { background-color: #739552; }
    .selected { background-color: rgba(20, 85, 30, 0.6) !important; }
    .hint::after { content: ''; position: absolute; width: 25%; height: 25%; background: rgba(0,0,0,0.3); border-radius: 50%; z-index: 2; }
    .capture::after { content: ''; position: absolute; width: 85%; height: 85%; border: 5px solid rgba(0,0,0,0.3); border-radius: 50%; z-index: 2; }
    .piece { z-index: 1; text-shadow: 0 2px 5px rgba(0,0,0,0.6); }
    .white { color: #fff; }
    .black { color: #000; }
    .status-bar { display: flex; align-items: center; gap: 10px; margin-bottom: 15px; padding: 15px; background: #302e2b; border-radius: 5px; font-weight: bold; font-size: 18px; box-shadow: inset 0 2px 5px rgba(0,0,0,0.2); }
}

// ---------------------------------------------------------
// 1. LE MOTEUR D'ÉCHECS (Algorithmes Purs)
// ---------------------------------------------------------
$>js_script() {
    window.ChessEngine = new function() {
        // Plateau 1D (minuscules = noirs, MAJUSCULES = blancs)
        this.board = [
            "r","n","b","q","k","b","n","r",
            "p","p","p","p","p","p","p","p",
            "","","","","","","","",
            "","","","","","","","",
            "","","","","","","","",
            "","","","","","","","",
            "P","P","P","P","P","P","P","P",
            "R","N","B","Q","K","B","N","R"
        ];
        this.turn = 'w'; 
        this.sel = -1;
        this.status = ''; // check, mate, stalemate
        
        // Helpers
        const isWhite = c => c>='A' && c<='Z';
        const getColor = c => c==='' ? '' : (isWhite(c) ? 'w' : 'b');
        
        // Mouvements Pseudo-Légaux (Mouvements bruts des pièces)
        this.pseudoLegal = function(from, to, b) {
            let p = b[from]; if(p==='') return false;
            let c = getColor(p), tc = getColor(b[to]);
            if(c === tc) return false; // Tir ami interdit
            
            let r1 = Math.floor(from/8), c1 = from%8;
            let r2 = Math.floor(to/8), c2 = to%8;
            let dr = r2-r1, dc = c2-c1;
            let adr = Math.abs(dr), adc = Math.abs(dc);
            let type = p.toLowerCase();
            
            // Rayon laser pour vérifier si le chemin est libre
            const clearPath = () => {
                let sr = Math.sign(dr), sc = Math.sign(dc);
                let cr = r1+sr, cc = c1+sc;
                while(cr!==r2 || cc!==c2) {
                    if(b[cr*8+cc]!=='') return false;
                    cr+=sr; cc+=sc;
                } return true;
            };
            
            // Règles individuelles
            if(type==='p') {
                let dir = c==='w' ? -1 : 1; let sR = c==='w' ? 6 : 1;
                if(dc===0 && dr===dir && b[to]==='') return true; // Avance simple
                if(dc===0 && dr===dir*2 && r1===sR && b[to]==='' && b[(r1+dir)*8+c1]==='') return true; // Double avance
                if(adc===1 && dr===dir && tc!=='' && tc!==c) return true; // Capture
                return false;
            }
            if(type==='n') return (adr===2&&adc===1)||(adr===1&&adc===2); // Cavalier
            if(type==='b') return adr===adc && clearPath(); // Fou
            if(type==='r') return (adr===0||adc===0) && clearPath(); // Tour
            if(type==='q') return (adr===adc || adr===0 || adc===0) && clearPath(); // Reine
            if(type==='k') return adr<=1 && adc<=1; // Roi
            return false;
        };
        
        // Vérifie si une case est menacée
        this.isAttacked = function(pos, attackerColor, b) {
            for(let i=0; i<64; i++) {
                if(getColor(b[i]) === attackerColor) {
                    if(this.pseudoLegal(i, pos, b)) return true;
                }
            } return false;
        };
        
        // Vérifie l'Échec
        this.inCheck = function(color, b) {
            let k = color==='w' ? 'K' : 'k';
            let kPos = b.indexOf(k);
            let attacker = color==='w' ? 'b' : 'w';
            return this.isAttacked(kPos, attacker, b);
        };
        
        // Génère TOUS les coups 100% légaux d'une pièce
        this.getLegalMoves = function(from) {
            let moves = [];
            let c = getColor(this.board[from]);
            for(let i=0; i<64; i++) {
                if(this.pseudoLegal(from, i, this.board)) {
                    let nb = [...this.board]; // Clone le plateau
                    nb[i] = nb[from]; nb[from] = ''; // Simule le coup
                    if(!this.inCheck(c, nb)) moves.push(i); // Valide si le roi est en sécurité
                }
            } return moves;
        };
        
        // Calcule l'état final de la partie (Checkmate / Pat)
        this.calcState = function() {
            let hasMoves = false;
            for(let i=0; i<64; i++) {
                if(getColor(this.board[i]) === this.turn) {
                    if(this.getLegalMoves(i).length > 0) { hasMoves = true; break; }
                }
            }
            let check = this.inCheck(this.turn, this.board);
            if(check && !hasMoves) this.status = 'mate';
            else if(!check && !hasMoves) this.status = 'stalemate';
            else if(check) this.status = 'check';
            else this.status = '';
        };
        
        // Gestion des clics de l'utilisateur
        this.processClick = function(idx) {
            if(this.status === 'mate' || this.status === 'stalemate') return;
            
            let c = getColor(this.board[idx]);
            
            // Sélection d'une pièce
            if(this.sel === -1) {
                if(c === this.turn) this.sel = idx;
            } 
            // Déplacement ou changement de sélection
            else {
                if(idx === this.sel) {
                    this.sel = -1; 
                } else if(c === this.turn) {
                    this.sel = idx; 
                } else {
                    let legalMoves = this.getLegalMoves(this.sel);
                    if(legalMoves.includes(idx)) {
                        this.board[idx] = this.board[this.sel];
                        this.board[this.sel] = '';
                        
                        // Promotion Reine
                        let row = Math.floor(idx/8);
                        let type = this.board[idx].toLowerCase();
                        if(type==='p' && (row===0 || row===7)) {
                            this.board[idx] = this.turn==='w' ? 'Q' : 'q';
                        }
                        
                        // Fin du tour
                        this.turn = this.turn==='w' ? 'b' : 'w';
                        this.sel = -1;
                        this.calcState();
                    } else {
                        this.sel = -1; // Coup interdit annulé
                    }
                }
            }
        };
    }();
    return "";
}

// ---------------------------------------------------------
// 2. CONTRÔLEUR TENYSCRIPT (Pont Événementiel)
// ---------------------------------------------------------
$>def JouerCoup(index) {
    $>js_script() { window.ChessEngine.processClick(Number($index)); return ""; }
    $>dom_update("#app_echecs", $>AfficherJeu())
}


// ---------------------------------------------------------
// 3. VUE TENYSCRIPT (Générateur d'Interface Sécurisé)
// ---------------------------------------------------------
$>def AfficherJeu() {
    $>js_script() {
        // État de la partie
        let t = window.ChessEngine.turn;
        let s = window.ChessEngine.status;
        let msg = t==='w' ? "Trait aux Blancs" : "Trait aux Noirs";
        let cCol = t==='w' ? "#ecf0f1" : "#7f8c8d";
        
        if(s==='mate') { msg = "ÉCHEC ET MAT !"; cCol = "#e74c3c"; }
        if(s==='stalemate') { msg = "PAT - Match Nul."; cCol = "#f1c40f"; }
        if(s==='check') { msg = "ÉCHEC ! " + msg; cCol = "#e67e22"; }
        
        window.TenyGlobalVars.statusColor = cCol;
        window.TenyGlobalVars.statusMsg = msg;
        
        // Rendu du plateau HTML
        let html = "<div class='board'>";
        let sel = window.ChessEngine.sel;
        let legalMoves = sel !== -1 ? window.ChessEngine.getLegalMoves(sel) : [];
        const SYM = { 'r':'♜','n':'♞','b':'♝','q':'♛','k':'♚','p':'♟', 'R':'♖','N':'♘','B':'♗','Q':'♕','K':'♔','P':'♙' };
        
        for(let i=0; i<64; i++) {
            let isDark = (Math.floor(i/8) + i%8) % 2 === 1;
            let cls = "square " + (isDark ? "dark" : "light");
            
            if(i === sel) cls += " selected";
            if(legalMoves.includes(i)) {
                if(window.ChessEngine.board[i] !== '') cls += " capture";
                else cls += " hint";
            }
            
            let p = window.ChessEngine.board[i];
            let pieceHtml = "";
            if(p !== '') {
                let pCol = (p >= 'a' && p <= 'z') ? 'black' : 'white';
                pieceHtml = "<span class='piece " + pCol + "'>" + SYM[p] + "</span>";
            }
            
            html += "<div class='" + cls + "' onclick='window.TenyGlobalRegistry.JouerCoup(" + i + ")'>" + pieceHtml + "</div>";
        }
        html += "</div>";
        window.TenyGlobalVars.htmlBoard = html;
        return "";
    }
    
    // Affichage structuré
    $>div("class='status-bar'", {
        $>span("style='width:20px; height:20px; border-radius:50%; background:$statusColor; box-shadow: 0 0 10px $statusColor;'", {})
        $statusMsg
    })
    
    $>div("", { $htmlBoard })
}

// ---------------------------------------------------------
// 4. LANCEMENT
// ---------------------------------------------------------
$>div("class='chess-wrapper' id='app_echecs'", {
    $>AfficherJeu()
})