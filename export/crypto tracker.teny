// ============================================================
// 💎 CRYPTO STREAMER (NO-BLINK ENGINE EDITION)
// ============================================================

// 1. Initialisation
$>js_url("https://cdn.jsdelivr.net/npm/chart.js")
$>css_style() {
    .crypto-card { flex:1; background:#1e1e1e; padding:15px; border-radius:8px; border:1px solid #444; }
    .price { font-size:1.8em; font-weight:bold; color:#fff; }
    .change { font-size:1em; }
    .green { color:#4caf50; }
    .red { color:#f44336; }
}

// 2. Structure HTML Initiale
$>div("id='streamer_root'", {
    $>div("style='display:flex; gap:10px;'", {
        $>div("class='crypto-card' style='border-color:#f7931a;'", {
            $>div("style='color:#888; font-size:0.9em;'", {"BITCOIN (BTC)"})
            $>div("id='price_btc' class='price'", {"Chargement..."})
            $>div("id='change_btc' class='change'", {"--"})
        })
        $>div("class='crypto-card' style='border-color:#627eea;'", {
            $>div("style='color:#888; font-size:0.9em;'", {"ETHEREUM (ETH)"})
            $>div("id='price_eth' class='price'", {"Chargement..."})
            $>div("id='change_eth' class='change'", {"--"})
        })
    })
    $>div("id='last_update' style='text-align:right; color:#555; font-size:0.8em; margin-top:5px;'", {"En attente..."})
})

// 3. LA BOUCLE MAGIQUE
$>def updateLoop() {
    $>var url = "https://api.coingecko.com/api/v3/simple/price?ids=bitcoin,ethereum&vs_currencies=usd&include_24hr_change=true"
    $>var data = $>http_get($url)
    
    $>if($data != null) {
        // Extraction avec le moteur
        $>var b_price = $>get($data, "bitcoin.usd")
        $>var b_chg = $>get($data, "bitcoin.usd_24h_change")
        $>var e_price = $>get($data, "ethereum.usd")
        $>var e_chg = $>get($data, "ethereum.usd_24h_change")
        
        // Mise à jour ciblée (DOM chirurgical)
        $>dom_update("#price_btc", "$b_price $")
        $>dom_update("#price_eth", "$e_price $")
        
        // Logique couleur BTC
        $>var classB = "red"
        $>var symB = "▼"
        $>if($b_chg > 0) {
            $>var classB = "green"
            $>var symB = "▲"
        }
        $>dom_update("#change_btc", "<span class='$classB'>$symB $b_chg %</span>")
        
        // Logique couleur ETH
        $>var classE = "red"
        $>var symE = "▼"
        $>if($e_chg > 0) {
            $>var classE = "green"
            $>var symE = "▲"
        }
        $>dom_update("#change_eth", "<span class='$classE'>$symE $e_chg %</span>")
        
        $>var now = $>date()
        $>dom_update("#last_update", "Synchro : $now")
    }

    $>wait(5000)
    $>updateLoop()
}

// Lancement
$>updateLoop()