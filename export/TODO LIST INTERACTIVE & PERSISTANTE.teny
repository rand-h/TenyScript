// ============================================================
// ✅ TODO LIST NATIVE & ROBUSTE (VERSION CORRIGÉE)
// ============================================================

// 1. FORCER L'ENREGISTREMENT DES FONCTIONS SYSTÈME
// Ceci règle l'erreur "len is not defined"
$>js_script() {
    window.TenyGlobalRegistry.len = (arg) => {
        if (Array.isArray(arg)) return arg.length;
        if (typeof arg === 'object' && arg !== null) return Object.keys(arg).length;
        return arg ? arg.toString().length : 0;
    };
    return "";
}

$>css_style() {
    .todo-card { background: #1e1e1e; padding: 20px; border-radius: 8px; border: 1px solid #333; max-width: 500px; margin: 0 auto; color: #fff; font-family: sans-serif; }
    .todo-item { background: #2d2d2d; padding: 10px; margin: 5px 0; display: flex; justify-content: space-between; align-items: center; border-radius: 4px; }
    .todo-btn { cursor:pointer; background:#d32f2f; color:white; border:none; padding:5px 10px; border-radius:3px; font-weight:bold; }
    .add-btn { background:#007acc; color:white; border:none; padding:10px; width:100%; margin-top:10px; cursor:pointer; font-weight:bold; border-radius:4px; }
}

// ---------------------------------------------------------
// 🧠 LOGIQUE (Classe persistante)
// ---------------------------------------------------------
$>class TodoApp() {
    $>var this.items = $>load_data("mes_taches")
    
    $>method init() {
        $>if($this.items == null) { $>var this.items = [] }
    }

    $>method add() {
        $>var val = $>dom_val("#input_tache")
        
        // Calcul manuel de la longueur pour éviter les erreurs de balise
        $>var n = $>len($val)
        
        $>if($n > 0) {
            $>push($this.items, $val)
            $>save_data("mes_taches", $this.items)
            $>dom_set_val("#input_tache", "")
            $>dom_update("#zone_liste", $>Render())
        }
    }

    $>method remove(idx) {
        $>var i = $>math($idx)
        $>var new_list = []
        $>var total = $>len($this.items)
        $>var k = 0
        $>while($k < $total) {
            $>if($k != $i) {
                $>push($new_list, $>get($this.items, $k))
            }
            $>var k = $>math($k + 1)
        }
        $>var this.items = $new_list
        $>save_data("mes_taches", $this.items)
        $>dom_update("#zone_liste", $>Render())
    }
}

$>new App = TodoApp()
$>App.init()

// ---------------------------------------------------------
// 🖥️ VUE (Interface)
// ---------------------------------------------------------
$>def Render() {
    $>var html = ""
    $>var total = $>len($App.items)
    $>var k = 0
    
    $>while($k < $total) {
        $>var item = $>get($App.items, $k)
        $>var html = $html + "<div class='todo-item'><span>" + $item + "</span><button class='todo-btn' onclick='$>BridgeRemove($k)'>X</button></div>"
        $>var k = $>math($k + 1)
    }
    
    $>if($total == 0) { $>var html = "<i style='color:gray'>Aucune tâche.</i>" }
    $html
}

// Ponts vers le Global Registry
$>def BridgeRemove(idx) { $>App.remove($idx) }
$>def BridgeAdd() { $>App.add() }

// ---------------------------------------------------------
// 🚀 POINT D'ENTRÉE
// ---------------------------------------------------------
$>div("class='todo-card'", {
    $>div("style='font-size:1.5em; font-weight:bold; margin-bottom:15px;'", {"MA LISTE DE TÂCHES"})
    
    $>div("id='zone_liste'", { $>Render() })
    
    $>espace(10)
    $>print($>input("input_tache", "Nouvelle tâche..."))
    $>button("class='add-btn' onclick='$>BridgeAdd()'", {"AJOUTER"})
})